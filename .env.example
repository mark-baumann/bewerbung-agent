# Alle Zugaenge lassen sich auch in der Web-UI eintragen (Profil -> Zugaenge);
# dort gespeicherte Werte haben Vorrang vor dieser Datei.

# Fuer LLM-Bewertung, Anschreiben und den Browser-Agenten.
# Anthropic, OpenAI ODER Ollama (OpenAI-kompatibel) konfigurieren.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- ODER: lokaler Ollama-Server (OpenAI-kompatibler Endpoint) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=                      # leer lassen, wenn die lokale Ollama keinen Key braucht
# OLLAMA_MODEL=                        # optional; nicht vorhandene Modelle werden ersetzt
# BROWSER_VISION=1                    # Screenshots an Ollama nur bei Vision-Modellen (sonst HTTP 500)

# Optional: Login der Jobboerse, falls eine Stelle "Online bewerben" ueber das
# BA-Konto verlangt. Der Browser-Agent bekommt diese Werte nur als Platzhalter
# zu sehen, eingesetzt werden sie erst im Browser.
BA_BENUTZER=
BA_PASSWORT=

# --- Bewerbungen per E-Mail (dein eigenes Postfach) ---
# Ohne diese Angaben gehen Bewerbungen nur ueber Online-Formulare raus.
# SMTP_HOST=smtp.example.de
# SMTP_PORT=465                        # 465 = SSL, 587 = STARTTLS
# SMTP_BENUTZER=ich@example.de
# SMTP_PASSWORT=
# SMTP_ABSENDER=ich@example.de         # optional, Standard: SMTP_BENUTZER

# --- Antworten im Postfach erkennen (IMAP, nur lesend) ---
# IMAP_HOST=imap.example.de
# IMAP_PORT=993
# IMAP_BENUTZER=                       # Standard: SMTP_BENUTZER
# IMAP_PASSWORT=                       # Standard: SMTP_PASSWORT

# --- Zusaetzliche Jobboersen mit kostenlosem Key ---
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=
