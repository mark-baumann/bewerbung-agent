# Fuer LLM-Bewertung, Anschreiben und den Browser-Agenten
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Login der Jobboerse, falls eine Stelle "Online bewerben" ueber das
# BA-Konto verlangt. Der Browser-Agent bekommt diese Werte nur als Platzhalter
# zu sehen, eingesetzt werden sie erst im Browser.
BA_BENUTZER=
BA_PASSWORT=
