# Fuer LLM-Bewertung, Anschreiben und den Browser-Agenten.
# Entweder Anthropic ODER Ollama (OpenAI-kompatibel) konfigurieren.
ANTHROPIC_API_KEY=sk-ant-...

# --- ODER: lokaler Ollama-Server (OpenAI-kompatibler Endpoint) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=                      # leer lassen, wenn die lokale Ollama keinen Key braucht
# OLLAMA_MODEL=glm-5.3-flash           # Modell fuer Bewertung & Anschreiben

# Optional: Login der Jobboerse, falls eine Stelle "Online bewerben" ueber das
# BA-Konto verlangt. Der Browser-Agent bekommt diese Werte nur als Platzhalter
# zu sehen, eingesetzt werden sie erst im Browser.
BA_BENUTZER=
BA_PASSWORT=
